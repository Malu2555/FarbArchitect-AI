# -----------------------------------------------------------------------------
# fabArchitect AI — backend environment template (local dev only)
# -----------------------------------------------------------------------------
# Copy to backend/.env and fill in real values for local testing.
# In production (Modal) all secrets come from modal.Secret.from_name("llm-keys")
# — the .env file is intentionally ignored by Modal image builds.

DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Meta Llama API -----------------------------------------------------------
META_LLAMA_KEY=sk-meta-replace-me
META_BASE_URL=https://api.llama.com/v1
META_MODEL_ID=meta-muse-wonder-2026

# --- Muse Image (spatial renderer, stage 2) -----------------------------------
# Leave META_IMAGE_MODEL_ID empty to force the deterministic local rasteriser.
META_IMAGE_MODEL_ID=meta-muse-image-2026
META_IMAGE_BASE_URL=https://api.llama.com/v1
META_IMAGE_TIMEOUT_S=45

# --- Fireworks AI fallback ----------------------------------------------------
FIREWORKS_API_KEY=fw_replace_me
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# IMPORTANT: Fireworks no longer serves Meta Llama models. Verify what your key
# can reach with `python scripts/list_fireworks_models.py`, then pick a
# non-reasoning chat model with `python scripts/probe_model_candidates.py`.
# minimax-m3 was the fastest JSON-clean non-reasoning option when this was
# measured: ~1.2 s/turn and reasoning_tokens=0.
FIREWORKS_MODEL_ID=accounts/fireworks/models/minimax-m3
# Read timeout (seconds) for chat-completions.
FIREWORKS_READ_TIMEOUT_S=45
# Output-token cap per call. 1024 comfortably fits the JSON correction object.
FIREWORKS_MAX_TOKENS=1024
# FIREWORKS_REASONING_EFFORT is deliberately absent: non-reasoning models
# reject the field. Only set it if you point FIREWORKS_MODEL_ID at a reasoning
# model (e.g. muse-spark-open on a Fireworks account that still serves it).
# FIREWORKS_REASONING_EFFORT=low

# `meta` or `fireworks` — local override for deterministic testing
PROVIDER_PRIMARY=meta

# --- Rate limiting ------------------------------------------------------------
# Format: <count>/<period> where period is one of s, min, hour, day.
# Long spellings (minute/hour) are normalized automatically.
RATE_SIMULATE=12/min       # expensive: physics + up to 3 LLM calls
RATE_HEALTH=120/min        # cheap liveness probe
RATE_HEALTH_DEEP=30/min    # introspection
RATE_PREVIEW=60/min        # physics-only scenario-editor preview (no LLM)
RATE_CATALOG=120/min       # static equipment catalog
RATE_ANON=60/min           # scope fallback for any future endpoint
TRUSTED_PROXY_HOPS=1       # Modal terminates TLS in front of the container
