# -----------------------------------------------------------------------------
# fabArchitect AI — backend environment template (local dev only)
# -----------------------------------------------------------------------------
# Copy to backend/.env and fill in real values for local testing.
# In production (Modal) all secrets come from modal.Secret.from_name("llm-keys")
# — the .env file is intentionally ignored by Modal image builds.

DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Meta Llama API -----------------------------------------------------------
META_LLAMA_KEY=sk-meta-replace-me
META_BASE_URL=https://api.llama.com/v1
META_MODEL_ID=meta-muse-wonder-2026

# --- Muse Image (spatial renderer, stage 2) -----------------------------------
# Leave META_IMAGE_MODEL_ID empty to force the deterministic local rasteriser.
META_IMAGE_MODEL_ID=meta-muse-image-2026
META_IMAGE_BASE_URL=https://api.llama.com/v1
META_IMAGE_TIMEOUT_S=45

# --- Fireworks AI fallback ----------------------------------------------------
# Fireworks on this account serves Meta-family models. The current default is
# `muse-spark-open`, a **reasoning** model that mirrors Muse Wonder for the
# strategy stage and Muse Image for the spatial stage. It needs
# `FIREWORKS_REASONING_EFFORT=low` and a 4096-token output budget (it spends
# ~640 tokens thinking before it emits JSON). The live catalog is:
#   python scripts/list_fireworks_models.py       (full list)
#   python scripts/probe_raw.py --model <id>      (correctness probe)
FIREWORKS_API_KEY=fw_replace_me
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL_ID=accounts/fireworks/models/muse-spark-open
# Read timeout (seconds) for chat-completions.
FIREWORKS_READ_TIMEOUT_S=45
# Output-token cap per call. 4096 leaves room for ~640 reasoning tokens PLUS
# the schema-valid JSON correction object. Drop to 1024 if you point this at a
# non-reasoning chat-instruct model.
FIREWORKS_MAX_TOKENS=4096
# `low` minimises reasoning tokens on reasoning models. Set explicitly empty
# (`FIREWORKS_REASONING_EFFORT=`) when pointing at a chat-instruct model that
# rejects the field.
FIREWORKS_REASONING_EFFORT=low

# --- Fireworks spatial-stage fallback (Stage 2) -------------------------------
# Mirrors `META_IMAGE_MODEL_ID`: same Fireworks key, same default model. Gives
# the spatial renderer a cross-provider fallback (Meta Image -> Fireworks
# Image -> deterministic rasteriser) without a second API account.
FIREWORKS_IMAGE_MODEL_ID=accounts/fireworks/models/muse-spark-open
# Optional override; defaults to FIREWORKS_BASE_URL.
# FIREWORKS_IMAGE_BASE_URL=https://api.fireworks.ai/inference/v1
# Optional override; defaults to FIREWORKS_MAX_TOKENS.
# FIREWORKS_IMAGE_MAX_TOKENS=4096
# Optional override; defaults to FIREWORKS_READ_TIMEOUT_S.
# FIREWORKS_IMAGE_TIMEOUT_S=45
# Optional override; defaults to FIREWORKS_REASONING_EFFORT.
# FIREWORKS_IMAGE_REASONING_EFFORT=low

# `meta` or `fireworks` — local override for deterministic testing
PROVIDER_PRIMARY=meta

# --- Rate limiting ------------------------------------------------------------
# Format: <count>/<period> where period is one of s, min, hour, day.
# Long spellings (minute/hour) are normalized automatically.
RATE_SIMULATE=12/min       # expensive: physics + up to 3 LLM calls
RATE_HEALTH=120/min        # cheap liveness probe
RATE_HEALTH_DEEP=30/min    # introspection
RATE_PREVIEW=60/min        # physics-only scenario-editor preview (no LLM)
RATE_CATALOG=120/min       # static equipment catalog
RATE_ANON=60/min           # scope fallback for any future endpoint
TRUSTED_PROXY_HOPS=1       # Modal terminates TLS in front of the container
