# Vercel → Modal endpoint base URL (no trailing slash)
VITE_BACKEND_URL=https://<your-org>--farbarchitect-ai-web.modal.run

# Used by the Vite dev proxy only — no need to deploy
VITE_DEV_BACKEND=http://127.0.0.1:8080

# Browser-side timeout for /simulate (ms). Reasoning models such as
# Muse Spark can take 60-120 s for physics + up to 3 correction turns.
VITE_SIMULATE_TIMEOUT_MS=180000
