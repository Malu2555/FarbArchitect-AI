    "predev": "node -e \"const n=process.versions.node.split('.')[0]; if(+n<26){console.error('Node >=26 required, got '+process.versions.node);process.exit(1)}\"",
    "prebuild": "node -e \"const n=process.versions.node.split('.')[0]; if(+n<26){console.error('Node >=26 required, got '+process.versions.node);process.exit(1)}\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
